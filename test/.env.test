# Environment for `npm test`. Committed on purpose: nothing here is a real credential.
#
# The suite runs against a local Postgres built from stock-flow-documents/generated_schema.sql, never
# the shared cloud database. test/support/create-test-db.js drops and rebuilds stockflow_test on
# every run, so this must never point at a database whose contents matter.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stockflow_test
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

ACCESS_TOKEN_SECRET=test-only-access-secret-never-used-anywhere-else
ACCESS_TOKEN_SECRET_EXPIRE=15m
REFRESH_TOKEN_SECRET_EXPIRE=7d
SESSION_MAX_AGE=30d
REFRESH_REUSE_GRACE_SECONDS=30
AUTH_REFRESH_TRANSPORT=cookie
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=
