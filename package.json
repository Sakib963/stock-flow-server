{
  "name": "stock-flow-server",
  "version": "1.0.0",
  "description": "This is the server-side API for the StockFlow Inventory/Warehouse Management System. It is built using Express.js and connected to a PostgreSQL database to handle inventory, product, and sales data.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon ./server.js",
    "dev:local": "node tools/start-local-service.js",
    "test": "node test/support/create-test-db.js && node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-joi-validation": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.29.1",
    "moment-timezone": "^0.6.5",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.5.0"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
